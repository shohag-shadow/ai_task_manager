# Copy this file to .env and fill in your own values.
# .env is git-ignored; this template is safe to commit.

# Required
OPENAI_API_KEY=sk-your-key-here

# Optional. Leave empty for OpenAI directly, or set it for a compatible gateway.
OPENAI_BASE_URL=

# Optional. Defaults to gpt-4o-mini when left at this value.
MODEL_NAME=gpt-4o-mini
